#!/bin/sh
# Minimal udhcpc hook for Fundray Linux.
# udhcpc exports: interface, ip, subnet, router (list), dns (list)
RESOLV=/etc/resolv.conf

case "$1" in
  deconfig)
    ip addr flush dev "$interface" 2>/dev/null
    ;;
  bound|renew)
    ip addr add "$ip/${subnet:-255.255.255.0}" dev "$interface" 2>/dev/null
    ip link set "$interface" up
    for r in ${router:-}; do
      ip route add default via "$r" 2>/dev/null
    done
    : > "$RESOLV"
    for d in ${dns:-}; do
      echo "nameserver $d" >> "$RESOLV"
    done
    ;;
esac
exit 0
