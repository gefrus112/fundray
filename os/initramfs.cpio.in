# gen_init_cpio file list for the Fundray Linux initramfs.
# Placeholders are substituted by build.sh:
#   @BUSYBOX@  path to the freshly built *static* busybox binary
#   @CTTY@     path to the built ctty binary
#   @SRC@      this directory (os/initramfs)
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/tty 0666 0 0 c 5 0
nod /dev/tty0 0600 0 0 c 4 0
nod /dev/tty1 0600 0 0 c 4 1
nod /dev/ttyS0 0600 0 0 c 4 64
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 0755 0 0
dir /run 0755 0 0
dir /root 0700 0 0
dir /etc 0755 0 0
dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0
file /init @SRC@/init 0755 0 0
file /bin/busybox @BUSYBOX@ 0755 0 0
file /bin/ctty @CTTY@ 0755 0 0
file /bin/fundray @SRC@/bin/fundray 0755 0 0
file /etc/banner.txt @SRC@/etc/banner.txt 0644 0 0
file /etc/udhcpc.script @SRC@/etc/udhcpc.script 0755 0 0
file /etc/os-release @SRC@/etc/os-release 0644 0 0
file /etc/passwd @SRC@/etc/passwd 0644 0 0
file /etc/group @SRC@/etc/group 0644 0 0
slink /bin/sh /bin/busybox 0777 0 0
